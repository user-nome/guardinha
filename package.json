{
  "name": "guardinha",
  "productName": "Guardinha",
  "version": "2.4.1",
  "description": "Cofre de credenciais 100% offline para Linux Mint 22.X (Zena)",
  "main": "out/main/index.js",
  "desktopName": "guardinha.desktop",
  "type": "module",
  "keywords": [
    "security",
    "cofre",
    "senhas",
    "credenciais",
    "offline",
    "linux-mint"
  ],
  "author": "Otaku Delirante",
  "homepage": "https://github.com/user-nome/guardinha",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "GUARDINHA_VAULT_DIR=\"$PWD/.dev-vault\" electron-vite dev",
    "pre-build": "rm -rf out && rm -rf release",
    "build": "npm run pre-build && electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p tests/tsconfig.json && tsc --noEmit -p e2e/tsconfig.json",
    "lint": "eslint . --ext .ts,.tsx,.js,.jsx",
    "lint:fix": "eslint . --ext .ts,.tsx,.js,.jsx --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run security:audit && npm run lint:shell",
    "security:audit": "bin/osv-scanner scan source --lockfile package-lock.json --config .osv-scanner.toml --all-vulns --experimental-flag-deprecated-packages --licenses=MIT,MIT-0,ISC,Apache-2.0,BSD-2-Clause,BSD-3-Clause,0BSD,BlueOak-1.0.0,Python-2.0,CC0-1.0,CC-BY-4.0,WTFPL,MPL-2.0 .",
    "lint:shell": "bin/shellcheck build/scripts/after-install.sh build/scripts/after-remove.sh build/scripts/guardinha-setup",
    "test": "vitest run",
    "test:security": "vitest run tests/security",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "vitest run --config vitest.e2e.config.mts",
    "test:e2e:bundled": "vitest run --config vitest.e2e.config.mts e2e/bundled.e2e.test.ts e2e/autolock.e2e.test.ts",
    "test:e2e:packaged": "vitest run --config vitest.e2e.config.mts e2e/packaged.e2e.test.ts",
    "test:mutation": "node tools/mutation/run.ts",
    "test:mutation:plan": "node tools/mutation/run.ts --list",
    "dist": "npm run build && electron-builder --linux deb --publish never",
    "dist:dir": "npm run build && electron-builder --linux deb --dir --publish never",
    "postinstall": "node node_modules/electron/install.js"
  },
  "dependencies": {
    "fs-extra": "^11.4.1",
    "hash-wasm": "^4.12.0",
    "lucide-react": "^1.62.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@babel/parser": "^8.0.8",
    "@babel/types": "^8.0.8",
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.5",
    "electron": "^45.1.0",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-i18next": "^6.1.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "playwright-core": "^1.64.1",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "allowScripts": {
    "electron@45.0.0": true,
    "electron-winstaller@5.4.0": true
  },
  "overrides": {
    "@electron/get": "^5.1.0",
    "@electron/asar": "4.3.1",
    "temp": {
      "rimraf": "^6.1.3"
    }
  },
  "build": {
    "appId": "com.guardinha.keypass",
    "productName": "Guardinha",
    "artifactName": "guardinha_${version}_${arch}.${ext}",
    "icon": "build/icon.png",
    "afterPack": "./build/after-pack.cjs",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "out/**/*",
      "build/icon.png",
      "THIRD-PARTY-NOTICES.txt",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "build/scripts/guardinha-setup",
        "to": "guardinha-setup"
      }
    ],
    "asar": true,
    "electronFuses": {
      "runAsNode": false,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableCookieEncryption": true,
      "onlyLoadAppFromAsar": true,
      "grantFileProtocolExtraPrivileges": false
    },
    "linux": {
      "target": [
        "deb"
      ],
      "category": "Utility",
      "executableName": "guardinha",
      "syncDesktopName": true,
      "maintainer": "Otaku Delirante <user-nome@users.noreply.github.com>",
      "synopsis": "Cofre de credenciais offline com criptografia AES-256-GCM"
    },
    "deb": {
      "priority": "optional",
      "afterInstall": "build/scripts/after-install.sh",
      "afterRemove": "build/scripts/after-remove.sh",
      "appArmorProfile": "build/apparmor-profile",
      "depends": [
        "libgtk-3-0",
        "libnotify4",
        "libnss3",
        "libxss1",
        "libxtst6",
        "xdg-utils",
        "libatspi2.0-0",
        "libuuid1",
        "libsecret-1-0"
      ]
    }
  }
}
